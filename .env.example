# ============================================================
# Task Iguana — Environment Variables
# Copy to .env.local and fill in your values
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (used for OAuth callbacks, email links, redirects)
NEXT_PUBLIC_APP_URL=https://www.taskiguana.com

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRICES={"starter":{"monthly":"price_...","annual":"price_..."},...}

# AI — Claude is primary, OpenAI is fallback
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Email (Resend)
RESEND_API_KEY=re_...

# Twilio (SMS + 2FA)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
TWILIO_MESSAGING_SERVICE_SID=MG...  # A2P 10DLC campaign — preferred over raw phone number
TWILIO_2FA_MESSAGING_SERVICE_SID=MG...

# QuickBooks (optional — only if QB integration enabled)
QUICKBOOKS_CLIENT_ID=...
QUICKBOOKS_CLIENT_SECRET=...
QUICKBOOKS_REDIRECT_URI=https://your-site.com/api/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox

# Google Calendar (optional — only if GCal integration enabled)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Name.com Domain Registration (optional — only for website builder)
NAMECOM_USERNAME=...
NAMECOM_API_TOKEN=...
NAMECOM_TEST_USERNAME=...
NAMECOM_TEST_TOKEN=...

# Cron Security (required — protects scheduled functions)
CRON_SECRET=your-random-secret-here

# Platform Admin
PLATFORM_ADMIN_EMAILS=admin@yourcompany.com

# Crisp (live chat widget — escalation from Ask Jenny)
# The widget is hidden by default and summoned via Ask Jenny's "Talk to a human" button.
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# ─── Sentry (error monitoring — optional but strongly recommended) ───────────
# Everything below is OPTIONAL. With no DSN set, Sentry is fully disabled and
# adds zero overhead. Paste your DSN to turn on production error monitoring.
# The DSN is public by design (it ships in the browser bundle), so it uses the
# NEXT_PUBLIC_ prefix and is safe to expose.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: label events by environment (defaults to NODE_ENV).
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional: performance trace sample rate 0..1 (defaults to 0.1).
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional: Session Replay. Set the on-error rate to 1 to record a replay of the
# user's session whenever an error occurs (great for a solo team).
NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0
# Build-time ONLY — used to upload readable source maps during `next build`.
# Not needed at runtime; leave blank to skip source-map upload. Get these from
# Sentry → Settings → Auth Tokens and your org/project slugs.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------
# Product analytics (PostHog) — powers the growth agent's sensing.
# ---------------------------------------------------------------
# Leave blank to disable analytics entirely: no script is loaded and every
# trackEvent() call becomes a no-op. That's the intended state for local dev,
# CI, and preview deploys.
#
# Get the project API key from PostHog → Project Settings → Project API Key.
# It is a *public* write-only key and is safe to expose in the browser.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional: defaults to https://us.i.posthog.com. Set to https://eu.i.posthog.com
# for the EU cloud, or your self-hosted URL.
NEXT_PUBLIC_POSTHOG_HOST=
